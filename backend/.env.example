# ══ INKU·AI Platform — Variáveis de Ambiente ══════════════════
# Copie este ficheiro para .env (desenvolvimento local)
# No Render.com: adicione cada variável em Dashboard → Environment

NODE_ENV=production
PORT=5000

# Base de dados PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.USER:PASS@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# JWT (gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=GERAR_AQUI
JWT_REFRESH_SECRET=GERAR_AQUI

# Google Gemini API — GRATUITO
# Obter chave em: https://aistudio.google.com/apikey
# Clica em "Create API Key" → copiar → colar abaixo
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

FRONTEND_URL=https://inkuai-platform.onrender.com
