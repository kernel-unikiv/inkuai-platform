# ═══════════════════════════════════════════════════════
#  INKU·AI Platform — Variáveis de Ambiente
#  Tudo abaixo é OPCIONAL para começar!
#  O sistema usa SQLite automaticamente se DATABASE_URL
#  não estiver definido.
# ═══════════════════════════════════════════════════════

# Servidor
NODE_ENV=development
PORT=5000

# ── BASE DE DADOS ────────────────────────────────────
# OPCIONAL: Se não definir, usa SQLite automático (ficheiro local)
# Para PostgreSQL (Supabase gratuito → supabase.com):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# OPCIONAL: MongoDB Atlas (gratuito → mongodb.com/cloud/atlas)
# Se não definir, usa memória RAM (dados perdem-se ao reiniciar)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/inkuai

# ── JWT (MUDE ISTO EM PRODUÇÃO!) ─────────────────────
JWT_SECRET=inkuai-dev-secret-change-this-in-production-2026
JWT_REFRESH_SECRET=inkuai-refresh-secret-change-this-in-production-2026
JWT_EXPIRES_IN=7d

# ── FRONTEND ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5000

# ── GITHUB OAUTH (opcional) ──────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── EMAIL SMTP (opcional) ────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
