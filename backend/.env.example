# ══ INKU·AI Platform — Variáveis de Ambiente ══════════════════
# Copiar este ficheiro para .env e preencher os valores reais

NODE_ENV=production
PORT=5000

# Base de dados PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.USER:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# JWT (gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=GERAR_VALOR_SEGURO_AQUI
JWT_REFRESH_SECRET=GERAR_VALOR_SEGURO_AQUI

# Anthropic API Key (obter em https://console.anthropic.com)
# OBRIGATÓRIO para o INKU·AI Assistant funcionar
ANTHROPIC_API_KEY=sk-ant-...

# Frontend URL (para CORS)
FRONTEND_URL=https://inkuai-platform.onrender.com
